{
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/28"
      ],
      "auto_route": true,
      "stack": "gvisor"
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "proxor-socks",
      "server": "127.0.0.1",
      "server_port": 2080
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "proxor-socks"
  },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "t",
        "server": "1.1.1.1",
        "tls": {
          "enabled": true,
          "certificate_path": "/etc/ssl/x.pem"
        }
      }
    ]
  }
}
